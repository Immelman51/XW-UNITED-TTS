<!-- X-Wing United : grand panneau de description affiché par un clic sur une fiche
     (un panneau par couleur de joueur, visible de ce joueur seulement).
     Ouvert par unitedShowDetail (Spawner.lua). Fichier généré : modifier le
     modèle ci-dessous puis régénérer les 12 panneaux à l'identique. -->
<Panel id="UnitedDetail_White" visibility="White" active="false" rectAlignment="MiddleCenter"
       width="1000" height="500" color="#101418F5" outline="#D9A61A" outlineSize="5 5"
       showAnimation="FadeIn" hideAnimation="FadeOut" onClick="unitedCloseDetail">
    <Text id="UnitedDetailTitle_White" raycastTarget="false" rectAlignment="UpperLeft" alignment="UpperLeft"
          offsetXY="30 -22" width="880" height="50" fontSize="36" fontStyle="Bold" color="#D9A61A"
          horizontalOverflow="Wrap" verticalOverflow="Overflow"></Text>
    <Text id="UnitedDetailText_White" raycastTarget="false" rectAlignment="UpperLeft" alignment="UpperLeft"
          offsetXY="30 -90" width="940" height="760" fontSize="28" color="#FFFFFF"
          horizontalOverflow="Wrap" verticalOverflow="Overflow"></Text>
    <Button rectAlignment="UpperRight" offsetXY="-14 -14" width="56" height="56" fontSize="32"
            colors="#00000000|#FFFFFF33|#FFFFFF55|#00000000" textColor="#FFFFFF" onClick="unitedCloseDetail">X</Button>
</Panel>
